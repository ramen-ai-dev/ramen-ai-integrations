{
  "name": "@ramen-ai/node-core",
  "version": "0.3.5",
  "description": "Agnostic Node.js HTTP core for the ramen-ai PaaS evaluation API, with V5 Ed25519 receipt verification (Web Crypto). Reusable SDK shared across ramen-ai integrations.",
  "license": "MIT",
  "homepage": "https://ramenai.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramen-ai-dev/ramen-ai-integrations.git",
    "directory": "core-clients/node"
  },
  "bugs": {
    "url": "https://github.com/ramen-ai-dev/ramen-ai-integrations/issues"
  },
  "keywords": [
    "ramen-ai",
    "ai-governance",
    "policy",
    "receipts",
    "ed25519"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=24"
  }
}
