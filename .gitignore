# ============================================================
# ramen-ai-integrations — .gitignore
# ============================================================

# --- Reference directories (local context only, never committed) ---
_ref/
_ref_archive/

# --- Internal contributor guidance (local only, never committed) ---
/AGENTS.md
/docs/adding-integration-logos.md
/docs/integration-checklist.md
/docs/github-action-marketplace-teardown.md

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/cache
.yarn/unplugged
.pnp.*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/
*.whl
.venv/
venv/
env/
.Python
pip-wheel-metadata/

# --- Build outputs ---
dist/
build/
out/
*.tsbuildinfo

# GitHub Actions require their compiled single-file bundle to be committed,
# so the action's dist/ is explicitly tracked (overrides the dist/ rule above).
!plugins/github-action/dist/
!plugins/github-action/dist/**

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- IDE & OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Test coverage ---
coverage/
.coverage
htmlcov/
.pytest_cache/
.nyc_output/

# --- Logs ---
*.log
logs/

# --- MLflow local tracking artifacts ---
mlruns/
mlartifacts/
